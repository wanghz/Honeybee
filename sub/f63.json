          "youtube.com",
          ".youtube.com",
          "ggpht.com",
          "googleapis.com"
        ],
        "outbound": "remote"
      },
      {
        "rule_set": [
          "category-ads-all"
        ],
        "action": "reject"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
