        "clash_mode": "direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "proxy",
        "outbound": "Proxy"
      },
      {
        "domain_suffix": [
          ".xiangqi.com"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "google.com",
          ".google.com",
          "googleusercontent.com",
          ".gstatic.com",
          "accounts.google.com",
          "accounts.google.cn",
          "apis.google.com",
          "youtube.com",
          ".youtube.com",
          "ggpht.com",
          "googleapis.com"
        ],
        "outbound": "remote"
      },
      {
        "rule_set": [
          "category-ads-all"
        ],
        "action": "reject"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-cn.srs",
        "download_detour": "direct"
      },
      {
        "tag": "category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ads-all.srs",
        "download_detour": "direct"
      }
    ]
  },
  "inbounds": [
    {
      "domain_strategy": "prefer_ipv4",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "set_system_proxy": true,
      "sniff": true,
      "sniff_override_destination": true,
      "tag": "mixed-in",
      "type": "mixed",
      "users": []
