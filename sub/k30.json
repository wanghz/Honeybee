{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "server": "1.1.1.1",
        "detour": "Proxy",
        "tag": "remote"
      },
      {
        "type": "https",
        "server": "223.5.5.5",
        "tag": "local"
      },
      {
        "type": "hosts",
        "path": [],
        "predefined": {},
        "tag": "block"
      },
      {
        "type": "local"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "local",
      "rewrite_ttl": 60,
      "client_subnet": "1.1.1.1/24",
      "strategy": "prefer_ipv4"
    },
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "proxy",
        "outbound": "Proxy"
      },
      {
        "domain_suffix": [
          ".xiangqi.com"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "google.com",
          ".google.com",
          "googleusercontent.com",
          ".gstatic.com",
          "accounts.google.com",
          "accounts.google.cn",
          "apis.google.com",
          "youtube.com",
          ".youtube.com",
          "ggpht.com",
          "googleapis.com"
        ],
        "outbound": "remote"
      },
      {
        "rule_set": [
          "category-ads-all"
        ],
        "action": "reject"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-cn.srs",
        "download_detour": "direct"
      },
      {
        "tag": "category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://fastly.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ads-all.srs",
        "download_detour": "direct"
      }
    ]
  },
  "inbounds": [
    {
      "domain_strategy": "prefer_ipv4",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "set_system_proxy": true,
      "sniff": true,
      "sniff_override_destination": true,
      "tag": "mixed-in",
      "type": "mixed",
      "users": []
    }
  ],
  "outbounds": [
    {
      "tag": "Proxy",
      "type": "selector",
      "outbounds": [
        "🌏auto",
        "🌏 !Choose",
        "direct"
      ]
    },
    {
      "tag": "🌏 !Choose",
      "type": "selector",
      "outbounds": [
        "direct",
        "🇩🇪 DE🇩🇪",
        "🇮🇳 INT🌍",
        "🇮🇳 INT🌍 2"
      ]
    },
    {
      "tag": "🌏auto",
      "type": "urltest",
      "outbounds": [
        "🇩🇪 DE🇩🇪",
        "🇮🇳 INT🌍",
        "🇮🇳 INT🌍 2"
      ],
      "url": "http://connectivitycheck.platform.hicloud.com/generate_204",
      "interval": "30m",
      "tolerance": 500
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "tag": "🇩🇪 DE🇩🇪",
      "type": "vmess",
      "server": "tr1-smart.adelping.com",
      "server_port": 80,
      "uuid": "43dcdce1-3cea-4193-bc8d-90b92071d779",
      "security": "auto",
      "alter_id": 0,
      "packet_encoding": "xudp",
      "transport": {
        "type": "ws"
      }
    },
    {
      "tag": "🇮🇳 INT🌍",
      "type": "vmess",
      "server": "s5.forwardscdn.com",
      "server_port": 2091,
      "uuid": "82a010f9-1883-49a1-0f2e-6542e4c03611",
      "security": "auto",
      "alter_id": 0,
      "packet_encoding": "xudp"
    },
    {
      "tag": "🇮🇳 INT🌍 2",
      "type": "vmess",
      "server": "s2.forwardscdn.com",
      "server_port": 2088,
      "uuid": "e694ebc6-9257-4348-3128-b353005c4ce0",
      "security": "auto",
      "alter_id": 0,
      "packet_encoding": "xudp"
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "metacubexd",
      "external_ui_download_url": "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip",
      "external_ui_download_detour": "Proxy",
      "default_mode": "rule"
    }
  }
}